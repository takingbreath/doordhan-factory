#!/bin/sh
# The Python for the QC tools and the edit templates, on any machine: the QC environment on a Mac (pipeline/fetch_models.sh
# makes ~/.venvs/doordhan-qc, because MediaPipe has no wheel for Homebrew's Python), python3 everywhere else (the cloud
# installs the QC packages into python3). Usage: pipeline/qcpy pipeline/qc_gate.py work/<slug>/qc_manifest.json
Q="$HOME/.venvs/doordhan-qc/bin/python"
[ -x "$Q" ] && exec "$Q" "$@"
python3 -c "import numpy, scipy, cv2" >/dev/null 2>&1 || echo "qcpy: no QC environment here (python3 lacks the QC packages and ~/.venvs/doordhan-qc does not exist). Run: bash pipeline/fetch_models.sh" >&2
exec python3 "$@"
